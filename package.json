{
  "name": "highscore-database",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "init:db": "npm ci && npm run build",
    "start": "node ./dist/index.js",
    "start:debug": "npx nodemon -e ts --exec \"npm run build; npm run start\"",
    "build": "npx esbuild ./src/index.ts --bundle --platform=node --format=cjs --outfile=./dist/index.js",
    "start-db:session": "duckdb ./highscore_database/database/highscore.duckdb",
    "clean:nix": "rm -rf ./dist",
    "clean:win": "rmdir dist /s /q && rmdir node_modules /s /q",
    "test": "jest --config ./jest.config.ts"
  },
  "dependencies": {
    "@hapi/hapi": "^21.3.12",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.1.3-alpha.8",
    "@types/chance": "^1.1.6",
    "@types/hapi": "^18.0.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "chance": "^1.1.12",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
