{
  "name": "highscore-database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "init:db": "pnpm ci && pnpm run build",
    "start": "node ./dist/index.js",
    "start:debug": "npx nodemon -e ts --exec \"pnpm run build; pnpm start\"",
    "build": "vite build",
    "start-db:session": "duckdb ./highscore_database/database/highscore.duckdb",
    "clean:nix": "rm -rf ./dist",
    "clean:win": "rmdir dist /s /q && rmdir node_modules /s /q",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "commonjs",
  "dependencies": {
    "@hapi/hapi": "21.3.12",
    "uuid": "11.0.3"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.1.3-alpha.8",
    "@types/chance": "1.1.6",
    "@types/hapi": "18.0.14",
    "@types/node": "22.10.2",
    "chance": "1.1.12",
    "nodemon": "3.1.9",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.31.1",
    "vite": "6.3.4",
    "vitest": "3.1.2"
  }
}
